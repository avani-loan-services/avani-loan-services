# Environment Variables Template for Avani Loan Services Backend
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# VAPI AI Configuration
VAPI_API_KEY=REPLACE_WITH_PROVIDER_ISSUED_SECRET
VAPI_API_URL=https://api.vapi.ai
VAPI_ASSISTANT_ID=REPLACE_WITH_VAPI_ASSISTANT_ID
VAPI_PHONE_NUMBER=REPLACE_WITH_VAPI_PHONE_NUMBER

# Twilio Configuration (for SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Google Sheets Configuration
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your_google_private_key

# Zoho CRM Configuration
ZOHO_CRM_API_KEY=your_zoho_api_key
ZOHO_CRM_ORG_ID=your_zoho_org_id
ZOHO_CRM_MODULE=Leads

# Database Configuration (if using database instead of Google Sheets)
DB_TYPE=mongodb
DB_URI=mongodb://localhost:27017/avani-loans
# or for PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=avani_loans
# DB_USER=admin
# DB_PASSWORD=password

# Email Configuration (for transactional emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# WhatsApp Business API (Canonical Meta Cloud API Contract - Server-Only)
# Deprecated aliases: WHATSAPP_BUSINESS_ACCOUNT_ID, WHATSAPP_API_TOKEN, META_ACCESS_TOKEN
PROVIDER_MODE=mock
META_BUSINESS_ID=REPLACE_WITH_NUMERIC_META_BUSINESS_ID
META_APP_ID=REPLACE_WITH_NUMERIC_META_APP_ID
META_APP_SECRET=REPLACE_WITH_PROVIDER_ISSUED_SECRET
META_WABA_ID=REPLACE_WITH_NUMERIC_WABA_ID
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_NUMERIC_PHONE_NUMBER_ID
META_SYSTEM_USER_TOKEN=REPLACE_WITH_PROVIDER_ISSUED_SECRET
GRAPH_API_VERSION=v21.0
META_WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_PROVIDER_ISSUED_SECRET

# Make.com / Zapier Webhooks (for automation)
MAKE_WEBHOOK_URL=https://hook.make.com/...
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/...

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn (optional)

# Security
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key

# Business Configuration
BUSINESS_NAME=Avani Loan Services
BUSINESS_PHONE=+91 7249108474
BUSINESS_EMAIL=enquiry@avanifinserv.com
BUSINESS_ADDRESS=Rajiv Gandhi Chowk & Ausa Road, Mantri Nagar, Latur, Maharashtra – 413512

# Campaign Settings
DEFAULT_CALL_TIMEOUT=30
MAX_RETRIES=3
RETRY_INTERVAL=300

# Feature Flags
ENABLE_AI_CALLING=true
ENABLE_WHATSAPP=true
ENABLE_SMS=true
ENABLE_ANALYTICS=true
ENABLE_BULK_CAMPAIGNS=true
