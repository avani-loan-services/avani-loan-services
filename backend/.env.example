# Environment Variables Template for Avani Loan Services Backend
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# VAPI AI Configuration
VAPI_API_KEY=YOUR_VAPI_API_KEY_HERE
VAPI_API_URL=https://api.vapi.ai
VAPI_ASSISTANT_ID=9f322737-3bb8-467a-95e3-7a66f9a93dc1
VAPI_PHONE_NUMBER=+91 7249108474

# Twilio Configuration (for SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Google Sheets Configuration
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your_google_private_key

# Zoho CRM Configuration
ZOHO_CRM_API_KEY=your_zoho_api_key
ZOHO_CRM_ORG_ID=your_zoho_org_id
ZOHO_CRM_MODULE=Leads

# Database Configuration (if using database instead of Google Sheets)
DB_TYPE=mongodb
DB_URI=mongodb://localhost:27017/avani-loans
# or for PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=avani_loans
# DB_USER=admin
# DB_PASSWORD=password

# Email Configuration (for transactional emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# WhatsApp Business API (alternative to Twilio)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_TOKEN=your_whatsapp_api_token

# Make.com / Zapier Webhooks (for automation)
MAKE_WEBHOOK_URL=https://hook.make.com/...
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/...

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn (optional)

# Security
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key

# Business Configuration
BUSINESS_NAME=Avani Loan Services
BUSINESS_PHONE=+91 7249108474
BUSINESS_EMAIL=enquiry@avanifinserv.com
BUSINESS_ADDRESS=Rajiv Gandhi Chowk & Ausa Road, Mantri Nagar, Latur, Maharashtra – 413512

# Campaign Settings
DEFAULT_CALL_TIMEOUT=30
MAX_RETRIES=3
RETRY_INTERVAL=300

# Feature Flags
ENABLE_AI_CALLING=true
ENABLE_WHATSAPP=true
ENABLE_SMS=true
ENABLE_ANALYTICS=true
ENABLE_BULK_CAMPAIGNS=true
