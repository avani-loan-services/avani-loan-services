{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BankStatementNormalized",
  "type": "object",
  "required": [
    "accountNumberMasked",
    "totalCredits",
    "totalDebits",
    "bounceCount"
  ],
  "properties": {
    "accountNumberMasked": {
      "type": "string"
    },
    "bankName": {
      "type": "string"
    },
    "totalCredits": {
      "type": "number"
    },
    "totalDebits": {
      "type": "number"
    },
    "estimatedSalaryIncome": {
      "type": "number"
    },
    "bounceCount": {
      "type": "integer",
      "minimum": 0
    },
    "hasSevereBounceHistory": {
      "type": "boolean"
    }
  }
}