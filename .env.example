GOOGLE_SHEETS_ID=your-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "..."}
GEMINI_API_KEY=your_gemini_api_key_here

OMNIDM_CALLBACK_URL=https://your-domain.com/api/omnidm/webhook
OMNIDM_VERIFY_TOKEN=REPLACE_WITH_PROVIDER_ISSUED_SECRET
AVANI_CRM_WEBHOOK_URL=https://your-domain.com/api/save-lead

# =====================================================================
# Canonical Meta Business & WhatsApp Cloud API Configuration (Server-Only)
# Required in production; keep PROVIDER_MODE=mock in local/CI/test.
# Deprecated aliases (do NOT use in production): META_ACCESS_TOKEN,
# WHATSAPP_TOKEN, META_WHATSAPP_TOKEN, META_PHONE_NUMBER_ID, META_API_KEY
# =====================================================================
PROVIDER_MODE=mock
META_BUSINESS_ID=REPLACE_WITH_NUMERIC_META_BUSINESS_ID
META_APP_ID=REPLACE_WITH_NUMERIC_META_APP_ID
META_APP_SECRET=REPLACE_WITH_PROVIDER_ISSUED_SECRET
META_WABA_ID=REPLACE_WITH_NUMERIC_WABA_ID
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_NUMERIC_PHONE_NUMBER_ID
META_SYSTEM_USER_TOKEN=REPLACE_WITH_PROVIDER_ISSUED_SECRET
GRAPH_API_VERSION=v21.0
META_WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_PROVIDER_ISSUED_SECRET

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

CALCULATOR_ACCESS_PASSWORD=
CALCULATOR_SESSION_SECRET=
FINANCIAL_TOOLS_PASSWORD=
ADMIN_INITIAL_PASSWORD=

# =====================================================================
# Service-to-Service (S2S) Ecosystem Security & Integration Endpoints
# Never commit real secrets; inject via Vercel/VM env management.
# =====================================================================
SERVICE_ID=svc-loan-api
ECOSYSTEM_KEY_ID=v1-2026-11
ECOSYSTEM_SERVICE_SECRET=
ECOSYSTEM_SERVICE_SECRETS_JSON=
AVANI_CRM_URL=https://avani-ai-crm.vercel.app
LOAN_AGENTS_URL=https://avani-loan-agents.vercel.app
CALLING_AGENT_URL=
S2S_TIMEOUT_MS=5000
S2S_MAX_RETRIES=3
S2S_RATE_LIMIT_PER_MIN=300
GLOBAL_PRODUCTION_DISPATCH_ENABLED=false
