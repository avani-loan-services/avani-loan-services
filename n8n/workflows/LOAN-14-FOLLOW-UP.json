{
  "name": "AVANI LOAN — LOAN-14-FOLLOW-UP: Automated Cadence & Drip Follow-up",
  "meta": {
    "domainCode": "LOAN-14-FOLLOW-UP",
    "description": "Document reminder scheduling and appointment reminders",
    "version": "1.0.0",
    "owner": "Sachin Shinde",
    "system": "AVANI LOAN SERVICES"
  },
  "nodes": [
    {
      "id": "node-webhook-trigger",
      "name": "LOAN-14-FOLLOW-UP Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "loan/loan-14-follow-up",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "node-auth-guard",
      "name": "HMAC & Security Guard",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        320,
        300
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.headers[\"x-avani-secret\"] ? true : false }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "node-domain-processor",
      "name": "Execute Automated Cadence & Drip Follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Domain processor for LOAN-14-FOLLOW-UP\nconst payload = $input.item.json.body || $input.item.json;\nconst correlationId = payload.correlationId || ('CORR-' + Date.now());\n\nreturn {\n  json: {\n    domain: 'LOAN-14-FOLLOW-UP',\n    status: 'PROCESSED',\n    correlationId: correlationId,\n    timestamp: new Date().toISOString(),\n    result: {\n      verified: true,\n      message: 'Workflow domain LOAN-14-FOLLOW-UP executed within policy boundary.'\n    }\n  }\n};"
      }
    },
    {
      "id": "node-dlq-routing",
      "name": "Route to DLQ on Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        540,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.avanifinserv.com/api/dlq",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { domain: \"LOAN-14-FOLLOW-UP\", error: $json.error, timestamp: $now } }}"
      }
    }
  ],
  "connections": {
    "LOAN-14-FOLLOW-UP Webhook Trigger": {
      "main": [
        [
          {
            "node": "HMAC & Security Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HMAC & Security Guard": {
      "main": [
        [
          {
            "node": "Execute Automated Cadence & Drip Follow-up",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route to DLQ on Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  }
}